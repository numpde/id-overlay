{
  "manifest_version": 3,
  "name": "id-overlay",
  "version": "0.0.1",
  "description": "Paste a screenshot as a visual overlay on top of the OpenStreetMap iD editor.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.openstreetmap.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.openstreetmap.org/edit*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/content.css",
        "src/content/main.js",
        "src/content/panel.js",
        "src/content/overlay.js",
        "src/content/page-adapter.js",
        "src/content/status-controller.js",
        "src/core/build-info.js",
        "src/core/value-store.js",
        "src/core/logger.js",
        "src/core/runtime-error.js",
        "src/core/interaction-mode.js",
        "src/core/interaction-policy.js",
        "src/core/panel-state.js",
        "src/core/ui-state-model.js",
        "src/core/ui-event-model.js",
        "src/core/ui-effect-model.js",
        "src/core/ui-live-effect-runner.js",
        "src/core/ui-live-state.js",
        "src/core/ui-live-transition.js",
        "src/core/ui-main-action-transition.js",
        "src/core/ui-mode-transition.js",
        "src/core/ui-transition-result.js",
        "src/core/ui-transition.js",
        "src/core/overlay-pointer-sequence.js",
        "src/core/image-policy.js",
        "src/core/image-normalization.js",
        "src/core/state.js",
        "src/core/presentation.js",
        "src/core/transform.js",
        "src/core/storage.js",
        "src/core/interactions.js"
      ],
      "matches": [
        "https://www.openstreetmap.org/*"
      ]
    }
  ]
}
