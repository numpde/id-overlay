{
  "manifest_version": 3,
  "name": "id-overlay",
  "version": "0.0.2",
  "description": "Paste a screenshot as a visual overlay on top of the OpenStreetMap iD editor.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.openstreetmap.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.openstreetmap.org/edit*"
      ],
      "js": [
        "src/content/content-loader.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
